      "value_name": "RmEdpBlenByAuxEnable",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nThis regkey enables panel backlight by aux\nBIT 0:0 - BL_EN by aux using callback function\n0 - (default - disabled)\n1 - Enables the backlight enablement by aux support.\nBIT 1:1 - BL_EN by aux using sor sequencer during modeset",
      "fields": [
        {
          "name": "USING_CALLBACK",
          "bits": [0],
          "states": [
            { "value": 0, "name": "FALSE" },
            { "value": 1, "name": "TRUE" }
          ]
        },
        {
          "name": "USING_SOR_SEQ",
          "bits": [1],
          "states": [
            { "value": 0, "name": "FALSE" },
            { "value": 1, "name": "TRUE" }
          ]
        }
      ]
    },
    {
      "name": "RMEdpPowerOnToMLTimeMs",
      "value_name": "RMEdpPowerOnToMLTimeMs",
