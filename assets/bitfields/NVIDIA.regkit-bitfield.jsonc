      ],
      "bit_width": 32,
      "comment": "TYPE DWORD\nSets the DEBUG CTRL register's dummy page size\nPrimarily used for testing different dummy page sizes for\nsparse textures. The override for big page size will only work\nif the GPU supports that big page size."
    },
    {
      "name": "RmSetPCIERelaxedOrdering",
      "value_name": "RmSetPCIERelaxedOrdering",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nThis regkey controls whether the PCIe relaxed ordering bit gets set in all\noutbound TLPs from the device or devices in question by controlling the\nNV_XVE_PRIV_MISC_1_CYA_WRITES_RELAXED_ORDERING bit.\nThis can be used as a per-device regkey or not, in which case the setting\nwill apply to all devices. If this key is supplied as both a per-device and\nnon-per-device regkey, the non-per-device option will apply first to all\ndevices, and then the per-device key settings will apply, overriding the\nsettings for the relevant devices.\nEncoding : 0 - Disable PCIe Relaxed Ordering TLP header bit setting. This is\nthe default option.\n1 - Try to enable PCIe Relaxed Ordering TLP header bit setting.\nTraverses the PCIe topology and only enables the header bit if\nit is safe to do so, with regard to all devices that could be\naffected.\n2 - Forcibly enable PCIe Relaxed Ordering TLP header bit setting.\nExplicitly ignores the compatibility of the PCIe topology\naround the device or devices in question.",
      "fields": [
        {
          "name": "RmSetPCIERelaxedOrdering",
          "bits": [0, 1],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "ENABLE" },
            { "value": 2, "name": "FORCE_ENABLE" }
          ]
        }
      ]
    },
    {
      "name": "RMSetSriovHeavyMode",
      "value_name": "RMSetSriovHeavyMode",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type: Dword\nEncoding:\n1 - SRIOV heavy mode is enabled\n0 - SRIOV heavy mode is disabled",
