      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nOverrides default settings for PG ENG based Deep Idle.\nDEFAULT  Takes default driver setting for feature\nDISABLE  Disables the feature\nENABLE   Enables the feature\nPGENG_FEATURE_STATE    : Defines state of PG ENG based Deep Idle. This is used to disable PG ENG\nbased Deep Idle and move back to legacy GC5.\nDEEP_L1                : If disabled then DI_ENG based DI will not engage even if DeepL1 is engaged.\nDI entry will get trigger by L1.1 or by L1.2.\nL1_SS                  : If disabled then DI_ENG based DI will not engage even if L1.1 or L1.2 is\nengaged. DI entry will get triggered by DeepL1.",
      "fields": [
        {
          "name": "PGENG_FEATURE_STATE",
          "bits": [0, 1],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "DISABLE" },
            { "value": 3, "name": "ENABLE" }
          ]
        },
