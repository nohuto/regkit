      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "TYPE DWORD\nContains the minimum p-state required to properly display overlays.\nThe value directly corresponds to the desired p-state:\n0 == P0\n1 == P1\n...\n15 == P15\nIf the specified p-state value is outside the range of valid p-states\n(0-15), the registry entry will be ignored. If the specified value is\nwithin the valid range of p-states but is not specifically supported,\nclosest higher performance p-state will be used.",
      "fields": [
        {
          "name": "RMIMPMinOverlayPstate",
          "bits": [0, 1, 2, 3],
          "states": [
            { "value": 0, "name": "P0" },
            { "value": 1, "name": "P1" },
            { "value": 2, "name": "P2" },
            { "value": 3, "name": "P3" },
            { "value": 4, "name": "P4" },
            { "value": 5, "name": "P5" },
            { "value": 6, "name": "P6" },
            { "value": 7, "name": "P7" },
            { "value": 8, "name": "P8" },
            { "value": 9, "name": "P9" },
            { "value": 10, "name": "P10" },
            { "value": 11, "name": "P11" },
            { "value": 12, "name": "P12" },
            { "value": 13, "name": "P13" },
            { "value": 14, "name": "P14" },
            { "value": 15, "name": "P15" }
          ]
        }
      ]
    },
