      "bit_width": 32,
      "comment": "Type Binary\nEncoding: This is a straight copy of the NVIF_Functions table from the RM.\nThe idea here is to save time from reading in this functionality during init\nto reduce boot time.  See bug 586829\nCan be disabled via NV_REG_STR_RM_DISABLE_REGISTRY_CACHE"
    },
    {
      "name": "RMNvLinkControl",
      "value_name": "RMNvLinkControl",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nNVLINK control overrides.\nFORCE_DISABLE: Force disable NVLINK when the current default is ON (POR)\nTRAIN_AT_LOAD : Force train links during driver load\nFORCE_AUTOCONFIG : Force autoconfig training regardless of chiplib forced config links\nFORCE_ENABLE: Force enable NVLINK when the current default is OFF (bringup etc.)\nPARALLEL_TRAINING: Have the GPU endpoint parallelize link training\nForce enable NVLink core lib to enable full link training on RTL sims",
      "fields": [
        {
          "name": "FORCE_DISABLE",
          "bits": [0],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
          ]
        },
        {
          "name": "TRAIN_AT_LOAD",
          "bits": [1],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
          ]
        },
        {
          "name": "SKIP_TRAIN",
          "bits": [2],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
          ]
        },
        {
          "name": "RESERVED_0",
          "bits": [3, 4, 5, 6, 7]
        },
        {
          "name": "FORCE_AUTOCONFIG",
          "bits": [8],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
          ]
        },
        {
          "name": "FORCE_ENABLE",
          "bits": [31],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
          ]
        }
      ]
    },
