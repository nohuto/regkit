      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding boolean\nEnable or disable a GPU cache if one exists and hw supports enabling/disabling.\n0 - Disables cache.\n1 - Enables cache.\nDefault 1",
