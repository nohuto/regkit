    {
      "name": "RmGpsPowerSteeringTempDelta",
      "value_name": "RmGpsPowerSteeringTempDelta",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nControls the temperature threshold used to activate/deactivate Power Steering.\nPower Steering will be active once GPU temperature will exceed current (dynamic)\nTemperature Controller's target temperature decreased by the amount provided in\nthis registry key (...TempDelta). Delta can be both positive and negative."
    },
    {
      "name": "RmGpsPreferIntrinsicFuncs",
      "value_name": "RmGpsPreferIntrinsicFuncs",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding Boolean\nPrefer use of CPU MSRs and similar interfaces instead of ACPI for handling\nfunctions such as CPU PL1/PL2 and CPU frequency control",
      "fields": [
        {
          "name": "RmGpsPreferIntrinsicFuncs",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
      ]
    },
    {
      "name": "RmGpsPsEnablePerCpuCoreDpc",
      "value_name": "RmGpsPsEnablePerCpuCoreDpc",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nThis is for the GPS power steering to use per core DPC threads\nto accumulate CPU counters\n0 - Disables GPS Power steering per core DPC thread\n1 - Default- Enables GPS Power steering per core DPC thread",
      "fields": [
        {
          "name": "RmGpsPsEnablePerCpuCoreDpc",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE", "meaning": "Type DWORD" }
          ]
        }
      ]
    },
    {
      "name": "RmGpsUtilHystHigh",
      "value_name": "RmGpsUtilHystHigh",
      "key_paths": [
