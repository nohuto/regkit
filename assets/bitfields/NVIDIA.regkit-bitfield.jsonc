          "bits": [4],
          "states": [
            { "value": 0, "name": "ENABLE" },
            { "value": 1, "name": "DISABLE" }
          ]
        },
        {
          "name": "FB",
          "bits": [5],
          "states": [
            { "value": 0, "name": "ENABLE" },
            { "value": 1, "name": "DISABLE" }
          ]
        },
        {
          "name": "ACB",
          "bits": [6],
          "states": [
            { "value": 0, "name": "ENABLE" },
            { "value": 1, "name": "DISABLE" }
          ]
