    },
    {
      "name": "RmConfComputeSpdmPolicy",
      "value_name": "RmConfComputeSpdmPolicy",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Enable/disable SPDM feature in Confidential Compute. SPDM-capable profiles\nmay not be loaded by default. This regkey allows us to override the default\nbehavior and force SPDM to enabled/disabled.\n0 - Feature disable\n1 - Feature enable",
      "fields": [
        {
          "name": "ENABLED",
          "bits": [0],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
          ]
        }
      ]
    },
    {
      "name": "RmConfidentialCompute",
      "value_name": "RmConfidentialCompute",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Add the conditions to exclude these macros from Orin build, as CONFIDENTIAL_COMPUTE\nis a guardword. The #if could be removed when nvRmReg.h file is trimmed from Orin build.\nEnable Disable Confidential Compute and control its various modes of operation\n0 - Feature Disable\n1 - Feature Enable",
      "fields": [
        {
          "name": "ENABLED",
          "bits": [0],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
          ]
        },
        {
          "name": "DEV_MODE_ENABLED",
          "bits": [1],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
          ]
        },
        {
          "name": "GPUS_READY_CHECK",
          "bits": [2],
          "states": [
            { "value": 0, "name": "DISABLED" },
            { "value": 1, "name": "ENABLED" }
          ]
        }
      ]
    },
    {
      "name": "RMConvertSplitRailSingleStepToMultiStepWAR",
      "value_name": "RMConvertSplitRailSingleStepToMultiStepWAR",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding boolean\nThis regkey will convert SPLIT_RAIL_SINGLE_STEP to\nSPLIT_RAIL_MULTI_STEP VOLT_POLICY. It has no effect if Voltage Policy Table\nin the VBIOS doesn't describe SPLIT_RAIL_SINGLE_STEP VOLT_POLICY.\nThe intended use case of this regkey is to WAR CS qual where they need a way\nto add delay while switching the rail voltages without flashing a new VBIOS\nfor SPLIT_RAIL_MULTI_STEP VOLT_POLICY. SPLIT_RAIL_SINGLE_STEP VOLT_POLICY\ndoesn't require intermediate voltage switches and hence for qualifiying the\nsplit rail min and max voltage delta constraints CS will use\nSPLIT_RAIL_MULTI_STEP VOLT_POLICY.\nTHIS REGKEY WON'T WORK BEFORE PASCAL AS SPLIT RAIL ITSELF ISN'T SUPPORTED!\n1 - Enables the WAR\n0 - Disables the WAR (default)",
      "fields": [
        {
          "name": "RMConvertSplitRailSingleStepToMultiStepWAR",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
      ]
    },
    {
      "name": "RMCoprocrefCount",
      "value_name": "RMCoprocrefCount",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nThis regkey controls delegate refcount change to worker thread or in current thread",
      "fields": [
        {
          "name": "STYLE",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "WORKERTHREAD" }
          ]
        }
      ]
    },
    {
      "name": "RmCpuFirmwareHandlesFbEccIntr",
      "value_name": "RmCpuFirmwareHandlesFbEccIntr",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "If the CPU Firmware (e.g. UEFI) on self-hosted platforms is enabled to handle the FB\nECC interrupt, then set this key to enable related code-paths in RM. This is\nIP_SENSITIVE code expected to run on Physical-RM only.\nEncoding: 1 - CPU Firmware is enabled to handle the FB ECC interrupt\n0 - CPU Firmware is not enabled to handle the FB ECC interrupt",
      "fields": [
        {
          "name": "RmCpuFirmwareHandlesFbEccIntr",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
      ]
    },
    {
      "name": "RMCreateAcrRegion1",
      "value_name": "RMCreateAcrRegion1",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "TYPE DWORD\nCreates ACR region with the parameters specified in the this Reg key. To create\nspecific region, refer to ACR_REGION_1 and ACR_REGION2\nACR_REGION_SIZE : Size needed for ACR region\nThis request automatically sets the ACR_READ_MASK to 0x7\nand ACR_WRITEMASK To 0x4. these are the default values.\nclient can override it using -acr_readmask and -acr_writemask\narguments.\nACR_REGION_READMASK: Specify the read mask of Priv Levels.\nACR_REGION_WRITEMASK : Specify the write mask of priv level\nACR_REGION_MEMALIGN : Alignment of the memory. Currently we support 4KB Alignment\nonly."
    },
    {
      "name": "RMCreateAcrRegion2",
      "value_name": "RMCreateAcrRegion2",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32
    },
    {
      "name": "RMCtxswLog",
      "value_name": "RMCtxswLog",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type: DWORD\nEncoding:\n3 - Enable interrupt-based FECS context switch logging with bottom-half/APC fall-back\n2 - Enable interrupt-based FECS context switch logging without bottom-half/APC fall-back\n1 - Enable periodic FECS context switch logging\n0 - Disable FECS context switch logging\nNote: Interrupt-based logging and periodic logging are mutually exclusive",
      "fields": [
        {
          "name": "RMCtxswLog",
          "bits": [0, 1],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" },
            { "value": 2, "name": "ENABLE_INTR" },
            { "value": 3, "name": "ENABLE_INTR_APC" }
          ]
        }
      ]
    },
    {
      "name": "RMCtxswLogMaxRecordsPerIntr",
