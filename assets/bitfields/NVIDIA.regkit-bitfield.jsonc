      ],
      "bit_width": 32,
      "comment": "Type DWORD\nThis regkey forces for Maxwell+ that on FB Unload we wait for FB pull before issuing the\nL2 clean. WAR for bug 1032432",
      "fields": [
        {
          "name": "RmL2CleanFbPull",
          "bits": [0],
          "states": [
            { "value": 0, "name": "ENABLED" },
            { "value": 1, "name": "DISABLED" }
          ]
        }
      ]
    },
    {
      "name": "RML2MaxWaysSysmem",
      "value_name": "RML2MaxWaysSysmem",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding Numeric Value\nIn cache only mode, sets the L2 MAX WAYS SYSMEM RD PINNED value which is used by\nby RM to control how much L2 cache will be reserved for sysmem reads vs vidmem operations",
      "fields": [
        {
          "name": "RML2MaxWaysSysmem",
          "bits": [0, 1, 2],
          "states": [
            { "value": 0, "name": "0_WAYS", "meaning": "Used for vidmem only" },
            { "value": 7, "name": "7_WAYS", "meaning": "Used for mixed sysmem/vidmem" }
          ]
        }
      ]
    },
    {
      "name": "RML2PreFill",
      "value_name": "RML2PreFill",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nIf set, RM will do a one-time pre-fill of all L2 cache during pre-init rather than on-demand\npre-filling when in cache only mode"
    },
    {
      "name": "RmLidPolicy",
      "value_name": "RmLidPolicy",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "TYPE DWORD\nEncoding: Used to force a particular kind of RM Lid Detection.\nUseful for developers, and specific OEM Machines with Bugs in some approaches.",
      "fields": [
        {
          "name": "RmLidPolicy",
          "bits": [0, 1, 2],
          "states": [
            { "value": 0, "name": "DSM", "meaning": "Force RM to trust that DSM method is available in SBIOS." },
            { "value": 1, "name": "DCS", "meaning": "Force RM to trust that DCS method is available in SBIOS." },
            { "value": 2, "name": "NVIF", "meaning": "Force RM to trust that SBIOS is NVIF LID compliant." },
            { "value": 3, "name": "ACPI", "meaning": "Force RM to trust that SBIOS is ACPI LID event capable." },
            { "value": 4, "name": "POLL", "meaning": "Force RM to fall back to Scratch bit polling." }
          ]
        }
      ]
    },
    {
      "name": "RMLimitMempoolRelativeToMscgWM",
      "value_name": "RMLimitMempoolRelativeToMscgWM",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nThis regkey allows the user to limit max mempool allocated to each client,\nto a value equal to MSCG high watermark (HWM) and some extra or less amount.\nThis extra/less amount is provided by this regkey in terms of a number. It\nspecifies relative to the HWM as 100%. So if the user wanted 10% above\nthe HWM, he would specify 110 in the reg key.\nMempool allocation will be capped at the original IMP-calculated value;\ni.e., the reg key will never cause the mempool to be over-allocated.\nAnd the mempool can't be allocated below min mempool.\nAny value - Enables and tells how much percentage we want set relative to\nMSCG HWM."
    },
    {
      "name": "RMLockingMode",
      "value_name": "RMLockingMode",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding enum\nOverrides what Locking Mode is in use.\nDefault 0",
      "fields": [
        {
          "name": "RMLockingMode",
          "bits": [0, 1],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "INTR_MASK" },
            { "value": 2, "name": "LAZY_INTR_DISABLE" }
          ]
        }
      ]
    },
    {
      "name": "RmLogonRC",
      "value_name": "RmLogonRC",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
