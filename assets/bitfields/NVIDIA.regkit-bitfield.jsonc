            { "value": 1, "name": "FORCESMOOTH", "meaning": "- ext. perf control p-state change always waits for VBLANK" },
            { "value": 2, "name": "FORCEMAYGLITCH", "meaning": "- ext. perf control p-state change doesn't wait for VBLANK" },
            { "value": 3, "name": "DEF2", "meaning": "- default GPU specific behavior (use _DEFAULT instead)" }
