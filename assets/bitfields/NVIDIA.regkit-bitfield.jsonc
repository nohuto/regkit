    },
    {
      "name": "RMBrightnessControlFlags",
      "value_name": "RMBrightnessControlFlags",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "TYPE DWORD\nNV_REG_STR_BRIGHTNESS_CONTROL_FLAGS_UNUSED:\nThese bits were used on older branches, but not here. Use this define to\nkeep the bits below in the same position as they were on older branches.\nNV_REG_STR_BRIGHTNESS_CONTROL_FLAGS_VBIOSRW:\nEnables or disables the reading/writing of VBIOS scratch registers. Note\nthat this does NOT prevent clients from actually using the VBIOS to set\nbrightness.\nNV_REG_STR_BRIGHTNESS_CONTROL_FLAGS_DXGKIFACE:\nEnables or disables DDI based brightness control on Vista and Win7.\nNote that even when enabled, conditions have to be met in order for DDI to\nbe supported.\nSPECIAL NOTE:\n_DXGKIFACE and _PBI become mutually exclusive if one of the fields\nis set to the _ENABLE value (e.g. if _DXGKIFACE_ENABLE is set, then the\n_PBI field is completely ignored). If multiple _ENABLE values are set,\nthe the priority goes from lowest to highest bit (_DXGKIFACE first, _PBI\nlast).\nNV_REG_STR_BRIGHTNESS_CONTROL_FLAGS_LEVELS:\nForce the use of NVIF or _BCL for brightness levels.\nNV_REG_STR_BRIGHTNESS_CONTROL_FLAGS_PBI:\nEnables or disables PBI registers for set/get PWM duty cycle.  This is\ndisabled by default for current GPUs, but may be enabled by default\nfor future GPUs.\nNV_REG_STR_BRIGHTNESS_CONTROL_FLAGS_FORCE_RM:\nForce RM to set the PWM duty cycle.  Default PMU will play this role on\nchips >= Kepler, RM do that otherwise.",
      "fields": [
        {
          "name": "UNUSED",
          "bits": [0, 1, 2, 3, 4, 5, 6, 7]
        },
        {
          "name": "VBIOSRW",
          "bits": [8, 9],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "ENABLE" },
            { "value": 2, "name": "DISABLE" }
          ]
        },
        {
          "name": "DXGKIFACE",
          "bits": [10, 11],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "ENABLE" },
            { "value": 2, "name": "DISABLE" }
          ]
        },
        {
          "name": "LEVELS",
          "bits": [12, 13],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "NVIF" },
            { "value": 2, "name": "BCL" }
          ]
        },
        {
          "name": "PBI",
          "bits": [14, 15],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "ENABLE" },
            { "value": 2, "name": "DISABLE" }
          ]
        },
        {
          "name": "FORCE",
          "bits": [16, 17],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "RM" },
            { "value": 2, "name": "PMU" }
          ]
        }
      ]
    },
