    },
    {
      "name": "RMDebugSetSMCNvLinkP2PMode",
      "value_name": "RMDebugSetSMCNvLinkP2PMode",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type: DWORD\nEncoding:\n0 - SMC and NvLink-P2P not compatible on a specific GPU\n1 - SMC and NvLink-P2P are compatible on a specific GPU\nIn Mods  SMC and NvLink/P2P will work on full GPU partition mode\nIn non-Mods environment, NvLink P2P is disabled by default",
      "fields": [
        {
          "name": "RMDebugSetSMCNvLinkP2PMode",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLED" },
            { "value": 1, "name": "ENABLED" }
          ]
        }
      ]
    },
    {
      "name": "RMDebugSMCDynamicTpcFs",
