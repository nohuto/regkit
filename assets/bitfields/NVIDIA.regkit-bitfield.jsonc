      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding Numeric Value in Mhz\nRegistry override for Max VCo Value in Mhz"
    },
    {
      "name": "FminVCO",
      "value_name": "FminVCO",
      "key_paths": [
