      ],
      "bit_width": 32,
      "comment": "Type Dword\nEncoding : 0       --> Skip Breakpoint\nnonzero --> Do Breakpoint\nFor Vista, Break on override Rm Disable and do RC error?",
      "fields": [
        {
          "name": "RmBreakonRCDisableOverride",
