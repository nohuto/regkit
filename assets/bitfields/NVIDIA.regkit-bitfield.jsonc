      ],
      "bit_width": 32,
      "comment": "Type: Dword\nEncoding:\nUSE_DEFAULTS   0   --> No effect.\nENABLE         1   --> Use PMU I2C if supported and when possible.\nDo not set enabled at the same time as any other RMUse*I2c.",
      "fields": [
        {
          "name": "RMUsePmuI2c",
          "bits": [0],
          "states": [
            { "value": 0, "name": "USE_DEFAULTS" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
