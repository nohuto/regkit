    {
      "name": "RMLpwrArch",
      "value_name": "RMLpwrArch",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nFor LPWR_ENG:\n0 : by default, LPWR_ENG is enabled on Turing_and_above GPUs\n1 : Disables LPWR_ENG. HW SM will run in PG_ENG mode.\nFor idle snap debug:\nThis feature sends debug message to RM whenever PMU sees idle snap.\n0 : Default value for feature\n1 : Disable\nFor PPU threshold:\n0 : Default value for the feature. PPU threshold will be activated only\nfor the exit triggered by engine holdoff.\n1 : Do not activate PPU threshold for any exit.\n3 : Activate PPU threshold for all exits.\nFor HW wakeup in SW blocker, API optimization and external API optimization:\n3 : Enable",
      "fields": [
        {
          "name": "LPWR_ENG",
          "bits": [0, 1],
          "states": [
            { "value": 0, "name": "ENG_TYPE_DEFAULT" },
            { "value": 1, "name": "DISABLE" },
            { "value": 3, "name": "RESERVED" }
          ]
        },
