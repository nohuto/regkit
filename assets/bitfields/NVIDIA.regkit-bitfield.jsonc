    {
      "name": "RMUse1to1ComptaglineAllocation",
      "value_name": "RMUse1to1ComptaglineAllocation",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nNumeric value to force allocation of Max comptagline field in PTE. To force,\nRM allocates maximum possible comptaglines possible for a chip, even though it's\nnot needed. This option takes effect in NV_VERIF_FEATURES builds only. Pascal+ only.\nvalue is enforced.\nEncoding -- 0 -- Disable testing max comptagline field\n-- 1 -- Enable testing max comptagline field",
      "fields": [
        {
          "name": "RMUse1to1ComptaglineAllocation",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
      ]
    },
    {
      "name": "RMUse1to4ComptaglineAllocation",
      "value_name": "RMUse1to4ComptaglineAllocation",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nNumeric value to enable 1:4 allocation of comptaglines to Compressible page size.\nAmpere+ only.\nvalue is enforced.\nEncoding -- 1 - Enabled testing of 1:4 allocation policy\n-- 1 - Disable testing of 1:4 allocation policy",
      "fields": [
        {
          "name": "RMUse1to4ComptaglineAllocation",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
