      "comment": "Type DWORD\nBitmask of PLLs to enable fractional divide (divide by 2) functionality\nfor those PLLs that support it (and is not the default)."
    },
    {
      "name": "RMEnableGA10XArchPerfMode",
      "value_name": "RMEnableGA10XArchPerfMode",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD:\nThis regkey is needed for perf runs and will set following PRIs as per the needs of the perf team-\n1. Disables CRD_COND_READ and\n2. Disables PLC_EXCLUDE_CROP\nEncoding : 1 - enable perf programming\n: 0 - disable, and default to driver behavior",
      "fields": [
