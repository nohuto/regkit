        {
          "name": "AELPG",
          "bits": [10, 11],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "ENABLE" },
            { "value": 2, "name": "DISABLE" },
            { "value": 3, "name": "MONITOR" }
          ]
        },
        {
          "name": "VIDEO_ELPG",
          "bits": [12, 13],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "ENABLE" },
