    {
      "name": "RMElpgStateOnInit",
      "value_name": "RMElpgStateOnInit",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type Dword\nThe default is to enable LPWR FSMs On Init. USe this regkey to override\nthe default behavior. Note that this is different from RMElpg which\nis to control (per engine) if LPWR FSM is actually supported.\nEncoding\nENABLE   enables the feature\nDISABLE  disables the feature",
      "fields": [
        {
          "name": "ON_INIT",
          "bits": [0, 1],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "ENABLE" },
            { "value": 3, "name": "DISABLE" }
          ]
        }
      ]
    },
    {
      "name": "RMemNBSItable",
      "value_name": "RMemNBSItable",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "The emulated NBSI table"
    },
    {
      "name": "RMEnableAcpiRom",
      "value_name": "RMEnableAcpiRom",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding boolean.\nEnable/Disable ACPI ROM method for non Hybrid system\nSome Discrete GPU system requires ACPI ROM method for extracting the VBIOS image,\nby default ACPI ROM method is being used for only Hybrid system\nnonzero        - Enable the ACPI ROM method, Only if BIOS supports ACPI_ROM\nzero (default) - Disable the ACPI ROM method for Non Hybrid",
      "fields": [
        {
          "name": "RMEnableAcpiRom",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
      ]
    },
    {
      "name": "RMEnableAcr",
      "value_name": "RMEnableAcr",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "TYPE DWORD\nForce enable Access Controlled Regions (ACR) in SW. Only needed for RTL & Tegra.\nACR is enabled in SW by default in all platforms, except RTL.\nIn Tegra, we also use this argument to enable VPR & WPR SoC fuses in development environments,\nnamely EMU, RTL, verif-silicon. In Tegra, GPU HW won't initialize without enabling WPR/VPR fuses.",
      "fields": [
        {
          "name": "RMEnableAcr",
          "bits": [0],
          "states": [
            { "value": 0, "name": "FALSE" },
            { "value": 1, "name": "TRUE" }
          ]
        }
      ]
    },
    {
      "name": "RMEnableAcrRiscv",
      "value_name": "RMEnableAcrRiscv",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "TYPE DWORD\nEnable ACR RISCV partition on GSP",
      "fields": [
        {
          "name": "RMEnableAcrRiscv",
          "bits": [0],
          "states": [
            { "value": 0, "name": "FALSE" },
            { "value": 1, "name": "TRUE" }
          ]
        }
      ]
    },
    {
      "name": "RmEnableAddressSpaceRC",
      "value_name": "RmEnableAddressSpaceRC",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type Dword\nEncoding : 0       --> Disable Address space level RC Recovery\nnonzero --> Enable Address space level RC Recovery\nEnable/Disable address space RC recovery in resource manager on RC errors",
      "fields": [
        {
          "name": "RmEnableAddressSpaceRC",
          "bits": [0],
          "states": [
