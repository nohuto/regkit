      ],
      "bit_width": 32,
      "comment": "Type: DWORD\nEncoding:\n0 - SMC Dynamic TPC Floorsweeping disabled on a specific GPU\n1 - SMC Dynamic TPC Floorsweeping enabled on a specific GPU and owned by RM\n2 - SMC Dynamic TPC Floorsweeping enabled and performed by devinit",
      "fields": [
