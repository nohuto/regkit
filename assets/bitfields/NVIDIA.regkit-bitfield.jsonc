      ],
      "bit_width": 32,
      "fields": [
        {
          "name": "MinPstateForHDVideo",
          "bits": [0, 1, 2, 3],
          "states": [
            { "value": 0, "name": "P0" },
            { "value": 8, "name": "P8" },
            { "value": 10, "name": "P10" },
