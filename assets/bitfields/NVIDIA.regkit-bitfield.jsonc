    {
      "name": "RmInternalDispMuxOverrides",
      "value_name": "RmInternalDispMuxOverrides",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Regkey to apply display MUX specific overrides.\nBIT   0:0 - Specifies whether to use I2C or AUX to wake the panel's link decode logic.\nThis apples only to NT71872.\n1 - Wakes the panel's link decode logic using I2C.\n0 - Wakes the panel's link decode logic using Aux.\nBIT   1:1 - Allows forcing dynamic mode forcefully even when SBIOS does not\nexpose the option. Used for testing purposes only.\n1 - Forces dynamic mode during initialization of display on eDP.\n0 - Default. Uses _MXDM to get the mode set by SBIOS during initialization.\nBIT   2:2 - Controls whether IGPU PSR with sideband mechanism needs to be\nenabled or disabled.\n1 - Disable IGPU PSR with sideband.\n0 - Default. IGPU PSR with sideband is enabled.\nBIT   3:3 - Controls whether NVTK FSM update only should be enabled only for mux\nswitch\n1 - Enable FSM update only for mux switch\n0 - Default. FSM updates are enabled for premux,postmux,mux operations.\nBIT   4:4 - Specifies whether eDP power-down should be skipped during both i2d\nand d2i switches\n1 - Skip eDP powerdown during both i2d and d2i switches\n0 - Default. Skip eDP powerdown only during d2i switch\nBIT   5:5 - Specifies whether driver should attempt to recover from SR exit failure in RM\nby resetting panel power.\n1 - Do nothing when SR exit fails in RM.\n0 - Default. When SR exit fails, write to 600h\nBIT  15:8 - Specifies the index in SW TCON database for the TCON to be emulated.\nThe index is valid only when the VALID bit (BIT 5) is set.\n0 - When specified SW emulates a TCON that does not support sideband functionality.\nBIT 16:16 - Indicates that the index specified at bit 4:1 is valid index to\nbe emulated. Without this bit set, TCON emulation is disabled.\nBIT 17:17 - Allows forcing the use of non-compliant Muxes. This forcefully enables dynamic mode\neven when the mux is not marked as compliant\n1 - Force the use of non compliant mux\n0 - Default. Don't use mux not marked compliant\nBIT 18:18 - Indicates that the index specified at bit 27:20 is valid Mux database index to\nbe emulated\nBIT 27:20 - Specifies the index in SW MUX database for the MUX to be emulated.\nThe index is valid only when the VALID bit (BIT 18) is set.",
      "fields": [
        {
          "name": "TRIGGER_TCON_D0_VIA_I2C",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "YES" }
          ]
        },
        {
          "name": "FORCE_DYNAMIC_MODE",
          "bits": [1],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "YES" }
          ]
        },
        {
          "name": "DISABLE_IGPU_PSR_SB",
          "bits": [2],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "YES" }
          ]
        },
        {
          "name": "ENABLE_FSM_UPDATE_ONLY_FOR_SWITCH",
          "bits": [3],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "YES" }
          ]
        },
        {
          "name": "ALWAYS_SKIP_EDP_POWERDOWN",
          "bits": [4],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "YES" }
          ]
        },
        {
          "name": "SKIP_SR_EXIT_RECOVERY",
          "bits": [5],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
          ]
        },
        {
          "name": "EMULATE_TCON_IDX_VAL",
          "bits": [8, 9, 10, 11, 12, 13, 14, 15],
          "states": [
            { "value": 0, "name": "SKIP_SB_SR" }
          ]
        },
        {
          "name": "EMULATE_TCON_IDX_VALID",
          "bits": [16],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
          ]
        },
        {
          "name": "FORCE_MUX_COMPLIANCE",
          "bits": [17],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
          ]
        },
        {
