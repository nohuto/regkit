      ],
      "bit_width": 32,
      "comment": "Type DWORD\nSet the link training waiting time of eDP from power on\n0xD2  - Use default waiting time 210ms.",
      "fields": [
        {
          "name": "RMEdpPowerOnToMLTimeMs",
          "bits": [0, 1, 2, 3, 4, 5, 6, 7],
          "states": [
            { "value": 210, "name": "DEFAULT" }
          ]
        }
      ]
    },
    {
      "name": "RMElcg",
      "value_name": "RMElcg",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nThis regKey is used for Engine Level Clock Gating settings\nEach engine uses 2 bits. For this regkey to be used, RmPowerFeatures\ncorresponding to this feature(5:4) should have a value of 2\n0 : Keep the vbios default, same as feature on i.e _AUTOMATIC\n1 : Engine disabled i.e. _DISABLED\n2 : block/suspend depending on the engine\nMPEG and PPP have same fields since mpeg is the name used for pre-gt200 (except g98)\nand ppp for beyond gt200 (+g98)",
      "fields": [
        {
          "name": "GR",
