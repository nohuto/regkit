    },
    {
      "name": "RMIsoCommitUnallocate",
      "value_name": "RMIsoCommitUnallocate",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\n0xff - Set _STALL_CYCLES_ISO_COMMIT_UNALLOCATE = NEVER\n(anything else) - use default setting\nWAR to avoid potential livelock in CBC.  See bug 1730392 for details.",
      "fields": [
        {
          "name": "RMIsoCommitUnallocate",
          "bits": [0, 1, 2, 3, 4, 5, 6, 7],
          "states": [
            { "value": 255, "name": "NEVER", "meaning": "Type DWORD" }
          ]
        }
      ]
    },
    {
      "name": "RmIsoHubMCLKSwitch",
      "value_name": "RmIsoHubMCLKSwitch",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD:\nEncoding -- Numeric bitmap field\nApplicable : GF119+ chips\nNote: On Ampere and later products, if the reg key is used to enable MID FRAME but disable DWCF, DWCF will actually\nbe only partially disabled. Furthermore, disabling DWCF while MID FRAME is enabled changes the frame timer, which\nMSCG also uses, so it is recommended that MSCG be disabled in this configuration.\nNote:\nOn Turing and earlier products, we have the following mclk switch methods:\n1) Memfetch vblank mode (_DMI enables/disables it)\n2) Midframe submode (_MID_FRAME enables/disables it)\n3) DWCF submode (_DWCF enables/disables it)\nOn Ampere and later products, we have the following mclk switch methods:\n1) Timer mechanism (_DWCF enables/disables it)\n2) Midframe submode (_MID_FRAME enables/disables it).\n_LEGACY_VBLANK is only supported on Pascal and earlier products.\n_MODE              Specify all possible different combinations of enabling mclk switch modes\n_NONE              Unknown Mclk Switch Mode, RM will use settings that got set by default. Need to use this mode\nif someone wants to just add delays (i.e 15:8 bits) with RM default mclk switch mode settings.\n_MID_FRAME:        Enable only MID FRAME watermark based mclk switching\n_DWCF:             Enable only DWCF watermark based mclk switching.\n_DMI:              Enable only DMI watermark based  mclk switching (Applicable only for GK104+ chips only).\n_LEGACY_VBLANK     Enable only LEGACY VBLANK i.e Disable ihub based mclk switching mode and defaults to old wait for vblank method.\nSet this field if some one wants to disable ihub based mclk switching path.\n_MID_AND_DWCF      Enable  MID FRAME and DWCF watermark based mclk switching.\n_MID_AND_DMI       Enable  MID FRAME and DMI watermark based mclk switching (Applicable only for GK104+ chips only).\n_DWCF_AND_DMI      Enable  DWCF and DMI watermark based mclk switching (Applicable only for GK104+ chips only).\n_MID_DWCF_AND_DMI  Enable  MID FRAME, DWCF and DMI watermark based mclk switching i.e all watermarks mentioned\nare used for window of opportunity calculation for mclk switch (Applicable only for GK104+ chips only).\n_VRR               Enable VRR based mclk switch mechanism (Applicable only for GK104+ chips only)\n_OSM               Enable One shot mode based mclk switch (Applicable only for TU10X+ chips only)\n_ADDITIONAL_DELAY: Bug 518879/573829: Additional delay (in usec) to add to MCLK switch sequence for testing.\n_REPLACEMENT_DELAY: Delay (in usec) to replace mclk switch with. A value of 0 means allow regular mclk switch to happen.",
      "fields": [
        {
          "name": "MODE",
          "bits": [0, 1, 2, 3],
          "states": [
            { "value": 0, "name": "NONE" },
            { "value": 1, "name": "MID_FRAME_ENABLE" },
            { "value": 2, "name": "DWCF_ENABLE" },
            { "value": 3, "name": "MID_AND_DWCF_ENABLE" },
            { "value": 4, "name": "DMI_ENABLE" },
            { "value": 5, "name": "MID_AND_DMI_ENABLE" },
            { "value": 6, "name": "DWCF_AND_DMI_ENABLE" },
            { "value": 7, "name": "MID_DWCF_AND_DMI_ENABLE" },
            { "value": 8, "name": "LEGACY_VBLANK_ENABLE" }
          ]
        },
        {
          "name": "MODE_VRR",
          "bits": [4],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
          ]
        },
        {
          "name": "MODE_OSM",
          "bits": [5],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
          ]
        },
        {
          "name": "ADDITIONAL_DELAY",
          "bits": [8, 9, 10, 11, 12, 13, 14, 15],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 255, "name": "MAX" }
          ]
        },
        {
          "name": "REPLACEMENT_DELAY",
          "bits": [16, 17, 18, 19, 20, 21, 22, 23],
          "states": [
            { "value": 0, "name": "DEFAULT" }
          ]
        }
      ]
    },
    {
      "name": "RMJTPowerControl",
      "value_name": "RMJTPowerControl",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "The following convention applies to PRGX:\n0 : EBPG - Link Enable Before GPU Power-on and GC6 Exit begins (X0)\n1 : EBPC - Link Enable at beginning of GPU GC6 Exit (X2)\n2 : EAGP - Link Enable After end of GPU GC6 Exit (X3)\n3 : EAPG - Link Enable After GPU Power-on Reset, but before GC6 Exit begins (X1a)\nThe following convention applies to PRGE:\n0 : DAGC - Link Disable After GC6 Entry complete and before GPU Power Down (E2)\n1 : DBGC - Link Disable Before GC6 Entry complete (E1)\n2 : DAGP - Link Disable After GC6 Entry and GPU Power Down is complete (E3)\n3 : DBGS - Link Disable Before GC6 Entry starts (E0)",
      "fields": [
        {
          "name": "PRGX",
          "bits": [8, 9],
          "states": [
            { "value": 0, "name": "EBPG" },
            { "value": 1, "name": "EBPC" },
            { "value": 2, "name": "EAGP" },
            { "value": 3, "name": "EAPG" }
          ]
        },
        {
          "name": "PRGE",
          "bits": [10, 11],
          "states": [
            { "value": 0, "name": "DAGC" },
            { "value": 1, "name": "DBGC" },
            { "value": 2, "name": "DAGP" },
            { "value": 3, "name": "DBGS" }
          ]
        }
      ]
    },
    {
      "name": "RMJTVerifCaps",
      "value_name": "RMJTVerifCaps",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nThis regkey overrides JT ACPI capabilities for verification.",
