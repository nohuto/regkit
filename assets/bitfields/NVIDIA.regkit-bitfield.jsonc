    {
      "name": "RMGpuOperationMode",
      "value_name": "RMGpuOperationMode",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nThis regKey is used to control power gate on boot mode during testing\nEach GPU Operation Mode mode uses 1 bit.\nFor this regkey to be used, RmPowerFeatures2\ncorresponding to this feature(5:4) should have a value of 2\n0 : Disable GPU Operation mode - power up unit after boot\n1 : Enable GPU Operation mode  - keep unit power gated after boot",
      "fields": [
        {
          "name": "COMPUTE",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
          ]
        },
        {
          "name": "TEX",
          "bits": [1],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
          ]
        },
        {
          "name": "DFMA",
          "bits": [2],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
      ]
    },
