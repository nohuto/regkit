    {
      "name": "ForceExtOnS3Resume",
      "value_name": "ForceExtOnS3Resume",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nOn Toshiba mobile systems, display will switch to external connected devices if\ndisplay was on LVDS only before entering S3 and more than one devices are connected\nupon resume, regardless of the lid state.\n0 or the absence of the key means this special feature is turned off\n1 means this special feature is turned on.",
      "fields": [
        {
          "name": "ForceExtOnS3Resume",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
      ]
    },
    {
      "name": "ForceP2P",
      "value_name": "ForceP2P",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type Dword\nEncoding Numeric Value\nOverrides chipset-based P2P configurations.\nOnly be used to test on internal issues\nP2P reads:\n0 - Do not allow P2P reads\n1 - Allow P2P reads\n2 - Do not override chipset-selected config (default)\nP2P writes:\n0 - Do not allow P2P writes\n1 - Allow P2P writes",
      "fields": [
        {
          "name": "READ",
          "bits": [0, 1],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" },
            { "value": 2, "name": "DEFAULT" }
          ]
        },
        {
          "name": "WRITE",
          "bits": [4, 5],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" },
            { "value": 2, "name": "DEFAULT" }
          ]
        }
      ]
    },
    {
      "name": "GlitchFreeMClk",
      "value_name": "GlitchFreeMClk",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nControl whether we should increase the vblank duration for a frame to eliminate the glitch\nwhile changing memory clock on an LVDS panel.\nNot present/1 = Increase hTotal to increase the vblank duration on LVDS panels.\n0 = Do not increase hTotal",
      "fields": [
        {
          "name": "GlitchFreeMClk",
          "bits": [0],
          "states": [
