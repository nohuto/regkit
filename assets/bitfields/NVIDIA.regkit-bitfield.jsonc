      "value_name": "RMSysmemOverridePcieReqAtomicOps",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "TYPE DWORD\nThis regkey overrides the supported PCIe requester atomic operations in MMU\nwhen PCIe atomics to Sysmem feature is enabled.\nNote: Keep this definition in the same order as PCIE_REQ_ATOMICS_* in bif.h\nwhich is also same as NV_PFB_PRI_MMU_ATOMICS_CTRL_PCIE_OP_* in dev_fb.h",
      "fields": [
        {
          "name": "RMSysmemOverridePcieReqAtomicOps",
          "bits": [0, 1, 2, 3, 4, 5, 6],
          "states": [
            { "value": 1, "name": "FETCHADD32" },
            { "value": 2, "name": "FETCHADD64" },
            { "value": 4, "name": "SWAP32" },
            { "value": 8, "name": "SWAP64" },
            { "value": 16, "name": "CAS32" },
            { "value": 32, "name": "CAS64" },
            { "value": 64, "name": "CAS128" }
          ]
        }
      ]
    },
    {
      "name": "RMSysmemPageSize",
      "value_name": "RMSysmemPageSize",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nContains the sysmem page size.\nEncoding -- Numeric value\nOverride the default large page size on fermi chips.  Normally this is determined\nby the configuration of the chip"
    },
    {
      "name": "RMSysmemSelectAtomicsConfig",
      "value_name": "RMSysmemSelectAtomicsConfig",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "TYPE DWORD\nThis regkey controls the atomics mode MMU expects for GPU initiated atomics to system\nmemory.\nNvLinkSelectAtomicsConfig is migrated to RMSysmemSelectAtomicsConfig\nRefer Bug 200644357 filed for the migration.\nCONFIG_PCIE force enables both the PCIe config setting AtomicOpReqEnable in Device\nControl 2 and the MODE_PCIE setting in MMU without checking the completer\nside atomic capabilities.",
      "fields": [
        {
          "name": "RMSysmemSelectAtomicsConfig",
          "bits": [0, 1, 2, 3, 4, 5, 6, 7, 8],
          "states": [
            { "value": 0, "name": "L2" },
            { "value": 1, "name": "POWER" },
            { "value": 2, "name": "XAVIER" },
            { "value": 3, "name": "RMW" },
            { "value": 4, "name": "READ" },
            { "value": 5, "name": "PCIE" },
            { "value": 256, "name": "DEFAULT" }
          ]
        }
      ]
    },
    {
      "name": "RMSysmemSelectAtomicsConfigNcoh",
      "value_name": "RMSysmemSelectAtomicsConfigNcoh",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "TYPE DWORD\nThis regkey controls what kind of atomics mode MMU expects for GPU initiated\natomics to system memory.",
      "fields": [
        {
          "name": "RMSysmemSelectAtomicsConfigNcoh",
          "bits": [0, 1, 2, 3, 4, 5, 6, 7, 8],
          "states": [
            { "value": 0, "name": "L2" },
            { "value": 1, "name": "SYSCOH" },
            { "value": 256, "name": "DEFAULT" }
          ]
        }
      ]
    },
    {
      "name": "RMSystemCrashOnEccDBE",
      "value_name": "RMSystemCrashOnEccDBE",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding 0 (default) - Don't crash node\n1           - Crash node on ECC DBE",
