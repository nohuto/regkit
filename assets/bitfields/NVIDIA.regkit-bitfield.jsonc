          ]
        }
      ]
    },
    {
      "name": "RmEnableCacheableControls",
      "value_name": "RmEnableCacheableControls",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Enable support for CACHEABLE rmapi control flag\n0: never cache any controls\n1 (default): cache only ROUTE_TO_PHYSICAL controls, and only if GSP-RM is running\n2: cache all controls",
      "fields": [
        {
          "name": "RmEnableCacheableControls",
          "bits": [0, 1],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "GSP_ONLY" },
            { "value": 2, "name": "ENABLE" }
          ]
        }
      ]
    },
    {
      "name": "RMEnableClk",
      "value_name": "RMEnableClk",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "TYPE DWORD\nEncoding -- Bit mask\nFilters the readable/programmable clk mask by ORing the given mask with it"
    },
    {
      "name": "RmEnableDHKeyExchange",
      "value_name": "RmEnableDHKeyExchange",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD (Boolean)\nOverride any other settings and enable DH Key Exchange"
    },
    {
      "name": "RmEnableEdidReadOnEmu",
      "value_name": "RmEnableEdidReadOnEmu",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD: Force EDID read on EMU. It enables I2C and removes static\nEDID on EMU. Only effective on Emulation. Also make sure to\nload EDID file on EMU when this regkey is used. Only use this\nto check any EDID specific feature as it slows down EMU\na lot. Don't use to just Enable HDMI, better option is to force\nHDMI_EN fuse on EMU to save the time. See Bug 2634173\nEncoding : 0 -- Disable EDID read on EMU\n: 1 -- Enable EDID read on EMU\nDefault - Disable\nThis regkey should only be used for emulation",
      "fields": [
        {
          "name": "RmEnableEdidReadOnEmu",
          "bits": [0],
          "states": [
            { "value": 0, "name": "FALSE" },
            { "value": 1, "name": "TRUE" }
          ]
        }
      ]
    },
    {
      "name": "RMEnableEventTracer",
      "value_name": "RMEnableEventTracer",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding bit mask\n[bit 0~3] Overall control bit\nbit 0 : Enable all events\nbit 1 : Disable Frequent Events (* see the detail below)\nbit 2 : Enable Flush - to flush events for debugging long-run issues (* see the detail below)\n[bit 4~ ] Individual Events Module enable bit\nbit 4 : Enable Perf related events\nbit 5 : Enable ELPG related events\nbit 6 : Enable NVDPS related events\nbit 7 : Enable Power related events\nbit 8 : Enable Display related events\nbit 9 : Enable RMAPI related events\nbit 10: Enable Interrupt related events\nbit 11: Enable Lock related events\nbit 12: Enable RCjournal related events\nbit 13: Enable Generic related events\nbit 14: Enable Thermal related events\nbit 15: Enable SPB related events\nAll other bits are reserved\nBit mask is defined in rmTracer.h\n<Disable Frequent Events>\nA frequent event is an event that happens very often, such as interrupts, rmctrls...\nand so on.  Setting this bit with bit 0 (Enable all events) can enable all those\nnon-freq events but dissable the freq ones.\nA frequent event is marked with flag RMTRACE_EVENT_FLAG_FREQ.\n<Enable Flush Events>\nWhile debugging long-run stress issues, we are interested in some particular driver\nactions, such as p-state change, modeset, Power State change and so on.  However those\ninformation sometimes get lost due to a system hard hang during the test.  The solution\nis to flush the event buffer each time when an interesting event is sent out.\nAn event can cause a flush is marked with flag RMTRACE_EVENT_FLAG_FLUSH.",
      "fields": [
        {
          "name": "RMEnableEventTracer",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
      ]
    },
    {
      "name": "RmEnableFbflcn",
      "value_name": "RmEnableFbflcn",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD (Boolean)\nEnable FB falcon -- FB falcon is disabled at TOT by default for now",
      "fields": [
        {
          "name": "RmEnableFbflcn",
          "bits": [0],
          "states": [
            { "value": 0, "name": "FALSE" },
            { "value": 1, "name": "TRUE" }
          ]
        }
      ]
    },
    {
      "name": "RMEnableFla",
      "value_name": "RMEnableFla",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nNumeric value to enable FLA for the RM.This option takes effect in\nNV_VERIF_FEATURES builds only. Ampere+ only.\nvalue is enforced.\nEncoding -- 0 -- Disable Fla\n-- 1 -- Enable Fla",
      "fields": [
        {
          "name": "RMEnableFla",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
      ]
    },
    {
      "name": "RmEnableFlaXid",
      "value_name": "RmEnableFlaXid",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Enable Destination side FLA translation XID.\n0 - (Default) Disable destination side FLA translation XID reporting\n1 - Enable destination side FLA translation XID reporting",
      "fields": [
        {
          "name": "RmEnableFlaXid",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLED" },
            { "value": 1, "name": "ENABLED" }
          ]
        }
      ]
    },
    {
      "name": "RmEnableFracDivide",
      "value_name": "RmEnableFracDivide",
