            { "value": 3, "name": "ALWAYS" }
          ]
        },
        {
          "name": "LPWR_CTRL_HW_DISABLE",
          "bits": [6, 7],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "DISABLE" },
            { "value": 3, "name": "ENABLE" }
          ]
        },
        {
          "name": "API_OPTIMIZATION",
          "bits": [8, 9],
          "states": [
            { "value": 0, "name": "DEFAULT" },
