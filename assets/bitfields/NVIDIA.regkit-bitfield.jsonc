          "bits": [2],
          "states": [
            { "value": 0, "name": "ENABLE" },
            { "value": 1, "name": "DISABLE" }
          ]
        },
        {
          "name": "DO_NOT_USE",
          "bits": [3],
          "states": [
            { "value": 0, "name": "ENABLE" },
            { "value": 1, "name": "DISABLE" }
          ]
        },
        {
          "name": "MS",
          "bits": [4],
          "states": [
            { "value": 0, "name": "ENABLE" },
            { "value": 1, "name": "DISABLE" }
          ]
        },
        {
          "name": "EI",
          "bits": [5],
          "states": [
            { "value": 0, "name": "ENABLE" },
            { "value": 1, "name": "DISABLE" }
          ]
        },
        {
          "name": "MS_LTC",
          "bits": [6],
          "states": [
            { "value": 0, "name": "ENABLE" },
            { "value": 1, "name": "DISABLE" }
