      ],
      "bit_width": 32,
      "comment": "TYPE DWORD\nThis regkey allows USB-C Debug Mode logging\n0 - (default)\n1 - Enables USB-C PMU event logging in RM",
      "fields": [
        {
          "name": "RMUsbcDebugMode",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
