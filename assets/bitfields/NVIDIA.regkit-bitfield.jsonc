    {
      "name": "RMExternalFabricMgmt",
      "value_name": "RMExternalFabricMgmt",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nRM external fabric management.\nRM currently uses nvlink core driver APIs which internally trigger\nlink initialization and training. However, nvlink core driver now exposes a\nset of APIs for managing nvlink fabric externally (from user mode).\nWhen the regkey is enabled, RM will skip use of APIs which trigger\nlink initialization and training. In that case, link training needs to be\ntriggered externally.",
      "fields": [
        {
          "name": "MODE",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
      ]
    },
