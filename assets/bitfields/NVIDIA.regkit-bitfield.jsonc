      ],
      "bit_width": 32,
      "comment": "Type DWORD\nThis Regkey controls inforom black box data recording. This can be used to\nrestrict access to BBX.\n0               - Enable BBX. (Default)\nCOMPLETELY      - Enable/Disable BBX access (read/write).\nWRITE_BY_RM     - Enable/Disable writes by RM itself.\nWRITE_BY_CLIENT - Enable/Disable writes by clients to RM.\nPERIODIC FLUSH  - Enable/Disable periodic flush to inforom (Also enables/disables Power data collection)",
      "fields": [
        {
          "name": "COMPLETELY",
          "bits": [0],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
          ]
        },
        {
          "name": "WRITE_BY_RM",
          "bits": [1],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
