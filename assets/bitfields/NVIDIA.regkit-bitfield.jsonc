    {
      "name": "Panel00",
      "value_name": "Panel00",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type Binary\nThe 00 will be replaced with the panel strap value 00->0F\nThe fields are all packed into one comma-separated string, with\nmost commonly overridden elements first.  In order to skip a\nfield in the string without overriding it, follow the preceding\ncomma immediately with another comma.\nField order: Manufacturer descriptor string,\nmanufacturer ID (3 chars),\nFeature Support,\nproduct code (2 bytes)"
    },
    {
      "name": "PanelBrightnessLimits",
      "value_name": "PanelBrightnessLimits",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "[Active only brightness control API activated]\nType REG_DWORD\nSpecifies minimum and maximum brightness levels for all panels,\nwithin range 0 (absolute minimum) to 255 (absolute maximum).\nByte 0 specifies minimum brightness level;\nByte 1 specifies maximum brightness level;\nByte 2 is ignored;\nByte 3 is ignored.\nIf not present,\nor if either level is out of range,\nor if min. level > max. level,\n=> default values DAC_MAX_BRIGHTNESS and DAC_MIN_BRIGHTNESS used."
    },
    {
      "name": "PanelPWMDutyRange",
      "value_name": "PanelPWMDutyRange",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type REG_DWORD\nSpecifies range of PWM duty cycle for all panels, in 0.1 percent.\nBits [15:0] specifies minimum PWM duty cycle in 0.1 percent.\nBits [31:16] specifies maximum PWM duty cycle in 0.1 percent.\nFor example, 0x03e8012c means 30.0% to 100.0%.\nIf not present or 0,\n=> default PWM range is from 0.0% to 100.0%."
    },
    {
      "name": "PanelPWMFrequency",
      "value_name": "PanelPWMFrequency",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "[Active only brightness control API activated]\nType REG_DWORD\nSpecifies PWM frequency to be used for all panels, in Hz.\nIf not present or 0,\n=> default PWM frequency defined by DAC_PWM_FREQUENCY is used."
    },
