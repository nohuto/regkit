            { "value": 4294967295, "name": "ALL_ENABLEALL" }
          ]
        }
      ]
    },
    {
      "name": "RmClkAdcCalRevCheckIgnore",
      "value_name": "RmClkAdcCalRevCheckIgnore",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Ignore checking the HW ADC calibration fuse version against the expected\nvalue in the VBIOS. This can be used to test early silicon which has not\nbeen fused correctly at ATE.\nType: DWORD\nBoolean variable:\n0 - Do not ignore the HW ADC calibration fuse version check (DEFAULT behavior)\n!0 - Ignore the ADC calibration fuse version check",
      "fields": [
        {
          "name": "RmClkAdcCalRevCheckIgnore",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
      ]
    },
    {
      "name": "RmClkAdcTempErrRevCheckIgnore",
      "value_name": "RmClkAdcTempErrRevCheckIgnore",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Ignore the mismatch seen between revision of ADC temperature error fuse\nand the expected fuse revision as indicated in the VBIOS. This can be used\nto test early silicon which has not been fused correctly at ATE or for debug\npurposes.\nType: DWORD\nBoolean variable:\n0 - Do not ignore the ADC temperature error fuse version check (DEFAULT behavior)\n!0 - Ignore the mismatch seen for ADC temperature error fuse version check",
      "fields": [
        {
          "name": "RmClkAdcTempErrRevCheckIgnore",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
      ]
    },
    {
      "name": "RmClkControllersOverride",
      "value_name": "RmClkControllersOverride",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Overrides RM Perf Clk controllers behavior\nType: DWROD\nDWORD bit-field with the following fields defined:\n_LOAD\n_DEFAULT - Loads all clk controllers\n_CLFC_DEFAULT - Loads all CLFC clk controllers data in PMU\n_CLFC_DISABLE - Skips loading all CLFC clk controllers data in PMU\n_CLVC_DEFAULT - Loads all CLVC clk controllers data in PMU\n_CLVC_DISABLE - Skips loading all CLVC clk controllers data in PMU\nThis will be used by clients like MODS to skip loading Perf CLK controllers data.",
      "fields": [
        {
          "name": "CLFC",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DEFAULT" },
