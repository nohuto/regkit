    {
      "name": "RMForceP2PType",
      "value_name": "RMForceP2PType",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nUse this regkey to force RM to pick a P2P type. HW has to support the picked TYPE to take effect.\ne.g., TYPE_BAR1P2P will not work if HW does not support it. A call to create NV50_P2P object will\nwill fail in such a case.\nTYPE_DEFAULT let RM to choose a P2P type. The priority is:\nC2C > NVLINK > BAR1P2P > mailbox P2P\nTYPE_C2C to use C2C P2P if it supports\nTYPE_NVLINK to use NVLINK P2P, including INDIRECT_NVLINK_P2P if it supports\nTYPE_BAR1P2P to use BAR1 P2P if it supports\nTYPE_MAILBOXP2P to use mailbox p2p if it supports",
      "fields": [
        {
          "name": "RMForceP2PType",
          "bits": [0, 1, 2],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "MAILBOXP2P" },
            { "value": 2, "name": "BAR1P2P" },
            { "value": 3, "name": "NVLINK" },
            { "value": 4, "name": "C2C" }
          ]
        }
      ]
    },
