    {
      "name": "MinPstateForSDVideo",
      "value_name": "MinPstateForSDVideo",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type Dword\nEncoding Possible values 0, 8, 10, 12, 15(none/default)",
      "fields": [
        {
          "name": "MinPstateForSDVideo",
          "bits": [0, 1, 2, 3],
          "states": [
            { "value": 0, "name": "P0" },
            { "value": 8, "name": "P8" },
            { "value": 10, "name": "P10" },
            { "value": 12, "name": "P12" },
            { "value": 15, "name": "NONE" }
