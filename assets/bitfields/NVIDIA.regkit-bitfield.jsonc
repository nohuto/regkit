    {
      "name": "RmBreak",
      "value_name": "RmBreak",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type Dword\nBitmap Encoding : 0       -->  Disable Functionality\n1       -->  Enable Functionality\nBitmap Enable/Disable breakpoint/Debug code in release resource manager\nExplicitly disable RmBreakOnRC for Retail <enable via registry> and\nRMCFG_IS_PLATFORM(GSP) builds",
      "fields": [
        {
          "name": "RmBreak",
          "bits": [0, 1, 2, 3, 4, 5, 6, 7, 8],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "RC_ENABLE" },
            { "value": 2, "name": "ASSERT_ENABLE" },
            { "value": 4, "name": "DBGBREAK_ENABLE" },
            { "value": 8, "name": "GPU_TIMEOUT_ENABLE" },
            { "value": 16, "name": "POOL_TAGS_ENABLE" },
            { "value": 32, "name": "POWER_ON_ENABLE" },
            { "value": 64, "name": "DEPRECATED" },
            { "value": 128, "name": "CRASH" },
            { "value": 256, "name": "CRASH_ON_RC", "meaning": "Type Dword" }
          ]
        }
      ]
    },
    {
      "name": "RmBreakonRC",
      "value_name": "RmBreakonRC",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
