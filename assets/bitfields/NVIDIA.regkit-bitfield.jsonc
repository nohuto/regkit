          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "DISABLE" },
            { "value": 2, "name": "ENABLE" }
          ]
        },
        {
          "name": "POLL_FOR_INIT_ACK",
          "bits": [4, 5],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "FALSE" },
            { "value": 2, "name": "TRUE" }
          ]
        }
      ]
    },
