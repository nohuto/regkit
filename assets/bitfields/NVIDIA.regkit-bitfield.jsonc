      ],
      "bit_width": 32,
      "comment": "Type DWORD: On some platform, Gen2 is disabled to work around system problems.\nThis key is to force enabling Gen2 for testing or other purpose.  It is\nineffective on platforms not Gen2 capable.\nEncoding boolean:\n0 - Do Nothing\n1 - Force Enable Gen2 (to invalidate PDB_PROP_CL_PCIE_GEN1_GEN2_SWITCH_CHIPSET_DISABLED)",
      "fields": [
        {
          "name": "RmForceEnableGen2",
          "bits": [0],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
          ]
        }
      ]
    },
    {
      "name": "RmForceEnablePcieGenSwitching",
      "value_name": "RmForceEnablePcieGenSwitching",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD: On some GPUs, we disable Gen1/Gen2 switching between p-states to\nWAR p-state switching hangs.  Instead we train to the Gen2 if the\nsystem supports it natively and never switch until driver unload.\nThis regkey will override that.\nEncoding boolean:\n0 - Force disable PCIE switching (to clear PDB_PROP_PERF_PCIEGEN_SWITCHING_ENABLE)\n1 - Force enable PCIE switching (to set PDB_PROP_PERF_PCIEGEN_SWITCHING_ENABLED)",
      "fields": [
        {
          "name": "RmForceEnablePcieGenSwitching",
