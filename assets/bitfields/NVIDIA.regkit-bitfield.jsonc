    {
      "name": "RMUseAltPR44UcodeImage",
      "value_name": "RMUseAltPR44UcodeImage",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "TYPE DWORD\nControls selection of PR4.4 ucode binaries for Ampere\nThis allows us to check in a temporary ucode that needs to be available\nin builds but not ready for widespread use.\nThis should only be used as a development feature. It is not intended to be used in\nproduction.\nTYPE Dword\nDetermines whether or not RM reserved space should be increased.\n1 - Increases RM reserved space\n0 - (default) Keeps RM reserved space as it is.",
      "fields": [
        {
          "name": "RMUseAltPR44UcodeImage",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "TRUE" }
          ]
        }
      ]
    },
    {
      "name": "RmUseAutoAcr",
      "value_name": "RmUseAutoAcr",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nThis regkey is effective only if regkey RmAcrSigningAlgo is set to 1 (PKC).\nThis dependency on RmAcrSigningAlgo will be replaced by PKC fuse when it is available.\n0 - RM uses PKC signed x86 ACR binaries\n1 - RM uses PKC signed Auto ACR binaries",
      "fields": [
        {
          "name": "RmUseAutoAcr",
          "bits": [0],
          "states": [
            { "value": 0, "name": "FALSE" },
            { "value": 1, "name": "TRUE" }
          ]
        }
      ]
    },
    {
