        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Used to enable and disable Twin Peak support. Default is disabled.",
      "fields": [
        {
          "name": "RMTwinPeaksSupport",
