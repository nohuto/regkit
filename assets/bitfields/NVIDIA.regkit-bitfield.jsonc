      ],
      "bit_width": 32,
      "comment": "Type DWORD\nRegkey to enable Pex Power Savings feature, disabled by default\n'Difference' (used below) means difference between new L1 residency and average of previous five\nLower limit diff percentage is the minimum difference against which idle threshold would be reduced / increased\nUpper limit diff percentage is a higher difference against which idle threshold would be reduced / increased\nLower limit new L1 residency is the absolute lower L1 residency value below which idle threshold won't be reduced\nUpper limit new L1 residency is the absolute higher L1 residency value below which idle threshold won't be reduced drastically",
      "fields": [
        {
          "name": "ENGAGE",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "ENABLE" }
          ]
        },
        {
          "name": "LOWER_LIMIT_DIFF_PERCENTAGE",
          "bits": [1, 2, 3, 4, 5, 6, 7],
          "states": [
            { "value": 5, "name": "INIT" }
          ]
        },
        {
          "name": "UPPER_LIMIT_DIFF_PERCENTAGE",
          "bits": [8, 9, 10, 11, 12, 13, 14],
          "states": [
            { "value": 10, "name": "INIT" }
          ]
        },
        {
          "name": "LOWER_LIMIT_NEW_L1_RESIDENCY",
          "bits": [15, 16, 17, 18, 19, 20, 21],
          "states": [
            { "value": 15, "name": "INIT" }
          ]
        },
        {
          "name": "UPPER_LIMIT_NEW_L1_RESIDENCY",
          "bits": [22, 23, 24, 25, 26, 27, 28],
          "states": [
            { "value": 30, "name": "INIT" }
          ]
        }
      ]
    },
    {
      "name": "RmPgCtrlAbortTimeout",
      "value_name": "RmPgCtrlAbortTimeout",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type Dword\nOverride default Abort timeout of MSCG in PMU.  Measured in microseconds.\nNot scaled for emulation"
