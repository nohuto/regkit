    {
      "name": "AdapterType",
      "value_name": "AdapterType",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding enum\nDefines the mode in which the display adapter is operating",
      "fields": [
        {
          "name": "AdapterType",
          "bits": [0, 1],
          "states": [
            { "value": 2, "name": "TCC" }
