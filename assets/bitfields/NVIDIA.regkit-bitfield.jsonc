      "comment": "objgpu.c\nType Dword\nOverride default RM timeout flags to either OSDELAY or OSTIMER.",
      "fields": [
        {
          "name": "RmDefaultTimeoutFlags",
          "bits": [0, 1, 2, 3],
          "states": [
            { "value": 4, "name": "OSTIMER" },
            { "value": 8, "name": "OSDELAY", "meaning": "Type Dword" }
          ]
        }
