      ],
      "bit_width": 32,
      "comment": "Type Dword\nWhen present and set to 1:       Allow Dynamic SLI transitions (Default)\nWhen present and set to 0:       Do not Dynamic SLI transitions",
      "fields": [
        {
          "name": "RMDynamicSLIAllowed",
