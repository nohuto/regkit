    {
      "name": "RmFan2XOverride",
      "value_name": "RmFan2XOverride",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nOverrides Fan 2.0 functionality\n0 - Use default POR for fan control.\n1 - Disable Fan 2.0 and fallback to Fan 1.0 or legacy fan control. Once\nFan 2.0 becomes a de-facto standard, setting this option would\ndisable RM/PMU fan control so there will be no change in fan speed.\n2 - Enable Fan 2.0 if VBIOS tables are present. If VBIOS tables aren't\npopulated, setting this option would disable RM/PMU fan control so\nthere will be no change in fan speed.",
      "fields": [
        {
          "name": "POR",
          "bits": [0, 1],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "DISABLE" },
            { "value": 2, "name": "ENABLE" }
          ]
        }
      ]
    },
    {
      "name": "RMFanSkipUnload",
      "value_name": "RMFanSkipUnload",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding 0 - Don't skip fan Unload(DEFAULT behavior)\n1 - Skip fan Unload\nThis is  used for ogtests Please refer to bug 556599",
      "fields": [
        {
          "name": "RMFanSkipUnload",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLED" },
            { "value": 1, "name": "ENABLED" }
          ]
        }
      ]
    },
    {
      "name": "RmFbhubRelaxedOrderingOverride",
      "value_name": "RmFbhubRelaxedOrderingOverride",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nThis regkey controls the relaxed ordering mode for the GPU. Applicable to Hopper+.\nDescription of upstream (atomics, reads, writes) modes from bug 2883106:\nThe modes are:\n1. FORCE_RO_0 -> Force RO=0 for all requests of that REQ_TYPE. This is equivalant to pre-Hopper behavior.\n2. FORCE_RO_1 -> Force RO=1 for all requests of that REQ_TYPE.\n3. SET_RO_FROM_STRONG -> Set RO based on the strong attribute of the request of that REQ_TYPE.\nFor SET_RO_FROM_STRONG mode, FBHUB sets RO for the PCIe request based on the strong attribute of the memory request.\nstrong==1 -> RO=0 (Request has to follow strict PCIe ordering)\nstrong==0 -> RO=1 (Request can take advantage of relaxed PCIe ordering)\nNo (current) use for setting downstream modes. Provided for future flexibility.\nThe regkey EnablePCIERelaxedOrderingMode sets the ordering mode to be FORCE_RO_1 globally - this behavior\nwill be mantained from previous generations. If more granular control is desired, this regkey should be used instead.",
      "fields": [
        {
          "name": "WRITES",
          "bits": [0, 1],
          "states": [
            { "value": 0, "name": "FORCERO0" },
            { "value": 1, "name": "FORCERO1" },
            { "value": 2, "name": "SETROFROMSTRONG" },
            { "value": 3, "name": "DEFAULT" }
          ]
        },
        {
          "name": "READS",
          "bits": [2, 3],
          "states": [
            { "value": 0, "name": "FORCERO0" },
            { "value": 1, "name": "FORCERO1" },
            { "value": 2, "name": "SETROFROMSTRONG" },
            { "value": 3, "name": "DEFAULT" }
          ]
        },
        {
          "name": "ATOMICS",
          "bits": [4, 5],
          "states": [
            { "value": 0, "name": "FORCERO0" },
            { "value": 1, "name": "FORCERO1" },
            { "value": 2, "name": "SETROFROMSTRONG" },
            { "value": 3, "name": "DEFAULT" }
          ]
        },
        {
          "name": "DOWNSTREAM_WRITES",
          "bits": [6, 7],
          "states": [
            { "value": 0, "name": "SRC" },
            { "value": 1, "name": "ALL" },
            { "value": 2, "name": "NONE" },
            { "value": 3, "name": "DEFAULT" }
          ]
        },
        {
          "name": "DOWNSTREAM_CPLS",
          "bits": [8, 9, 10],
          "states": [
            { "value": 0, "name": "ALLOWSSRC" },
            { "value": 1, "name": "ALLOWSSRCL2BONLY" },
            { "value": 2, "name": "ALLOWSSRCL2RONLY" },
            { "value": 3, "name": "ALLOWSNONE" },
            { "value": 4, "name": "DEFAULT" }
          ]
        }
      ]
    },
    {
      "name": "RMFbLinkTraining",
      "value_name": "RMFbLinkTraining",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD:\nEncoding -- Bit-mapping\nApplies to GDDR5 on GF1xx and later\n_ENABLE           : Enable link training. (enabled by default)\n_ON               : No currently being used.\n_PATTERN_VBIOS    : Enable VBIOS memory pattern table. (enabled by default)\n_PATTERN_INTERNAL : Disable internal memory pattern table (disabled by default)\nIf both _VBIOS and _INTERNAL are enabled, the VBIOS pattern table is used\niff it exists in the ROM, and the internal pattern table is used otherwise.\nType DWORD\nEncoding bit mask\nbit 0 : Enable fb link training\nbit 1 : Use CPU or PMU for link training\nBit mask defined in rmTracer.h",
      "fields": [
        {
          "name": "ENABLE",
          "bits": [0],
          "states": [
            { "value": 0, "name": "TRUE" },
            { "value": 1, "name": "FALSE" }
          ]
        },
        {
          "name": "ON",
          "bits": [4],
          "states": [
            { "value": 0, "name": "CPU" },
            { "value": 1, "name": "PMU" }
          ]
        },
        {
          "name": "PATTERN_VBIOS",
          "bits": [5],
          "states": [
            { "value": 0, "name": "ENABLE" },
            { "value": 1, "name": "DISABLE" }
          ]
        },
        {
          "name": "PATTERN_INTERNAL",
          "bits": [6],
          "states": [
            { "value": 0, "name": "ENABLE" },
            { "value": 1, "name": "DISABLE" }
          ]
        }
      ]
    },
    {
      "name": "RmFbsrFileMode",
      "value_name": "RmFbsrFileMode",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
