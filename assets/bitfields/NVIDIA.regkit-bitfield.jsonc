      ],
      "bit_width": 32,
      "comment": "Type: DWORD\nEncoding: A non-zero value will cause RM to disable sys pipes according to\neach bit set in the mask, with a mask of 1 corresponding to GR0. Disabling\nGR0 with this mask is disallowed."
    },
    {
      "name": "RMDeepL1EntryLatencyUsec",
