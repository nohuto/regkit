    {
      "name": "RmInterruptEscapes",
      "value_name": "RmInterruptEscapes",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nsend interrupt enable/disable are directed to HW escape calls.\nEncoding\nDISABLED - Change the default to disabled (default)\nENABLED - Change the default to enabled",
      "fields": [
        {
          "name": "RmInterruptEscapes",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLED" },
            { "value": 1, "name": "ENABLED" }
          ]
        }
      ]
    },
    {
      "name": "RMIntrDetailedLogs",
      "value_name": "RMIntrDetailedLogs",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type: DWORD\nEncoding:\n0 - Disable more detailed debug INTR logs\n1 - Enable more detailed debug INTR logs",
      "fields": [
        {
          "name": "RMIntrDetailedLogs",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLE" },
