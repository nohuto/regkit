        }
      ]
    },
    {
      "name": "RMUseAggressiveGC6",
      "value_name": "RMUseAggressiveGC6",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "TYPE DWORD\nEnables/Disables the use of Aggressive GC6\nEncoding 0 --> Do not use Aggressive GC6 (default)\n1 --> Use Aggressive GC6",
      "fields": [
        {
          "name": "RMUseAggressiveGC6",
          "bits": [0],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
