      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding: takes effect for allocations in VIDEO memory\nTRUE       Make allocation in protected region\nFALSE      Make allocation in non-protected region (default)",
      "fields": [
        {
          "name": "INSTBLK",
