    },
    {
      "name": "RMDevidCheckIgnore",
      "value_name": "RMDevidCheckIgnore",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding 0 - Don't ignore the PCI Devid check b/w vbios and chip (DEFAULT behavior)\n1 - Ignore the PCI Devid check\nThis is only used in debug and/or mods builds for testing",
      "fields": [
        {
          "name": "RMDevidCheckIgnore",
          "bits": [0],
          "states": [
