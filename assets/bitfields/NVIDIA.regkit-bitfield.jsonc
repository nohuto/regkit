          "bits": [1],
          "states": [
            { "value": 0, "name": "DISABLED" },
            { "value": 1, "name": "ENABLED" }
          ]
        }
      ]
    },
    {
      "name": "RMEnableASPMDT",
      "value_name": "RMEnableASPMDT",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\n0:0 - Set to 1 to enable L0s\n1:1 - Set to 1 to enable L1",
      "fields": [
