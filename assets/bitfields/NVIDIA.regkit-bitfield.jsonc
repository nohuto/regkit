      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding boolean\nIf set, this will cause RM operate in GPU Cache Only Mode and limit the FB\nsize to the size of GPU Cache for functional BIST",
