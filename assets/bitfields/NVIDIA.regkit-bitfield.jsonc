      "value_name": "RmSec2RtosOverrides",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding bit mask\nbits 1:0 : Whether to use Pwr Clk ticks for ctx switch interval\nNote that this override is only valid for fmodel. On all other platforms, we\nuse Nvd Clk ticks by default.\n0 - SEC2 RTOS uses the default for ctx switch interval\n1 - SEC2 RTOS uses Nvd Clk ticks for ctx switch interval\n2 - SEC2 RTOS uses Pwr Clk ticks for ctx switch interval\nbits 3:2 : Post a command to SEC2 RTOS on SEC2 clock changes\n0 - Use the default\n1 - Post a command to SEC2 RTOS on SEC2 clock changes\n2 - Don't post a command to SEC2 RTOS on SEC2 clock changes",
      "fields": [
        {
          "name": "USE_PWR_CLK_TICKS",
          "bits": [0, 1],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "FALSE" },
            { "value": 2, "name": "TRUE" }
