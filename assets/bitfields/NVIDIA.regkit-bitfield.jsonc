    {
      "name": "OverridePanelStrapAndIndex",
      "value_name": "OverridePanelStrapAndIndex",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding: Bits  0-3: Panel Strap override\nBits 8-11: Panel Table Index override\nAll other bits - undefined, set as 0 by default\nThis will allow a regkey override for the panel strap for PCVBIOS based machines"
    },
    {
      "name": "OverrideSBIOSDevs",
      "value_name": "OverrideSBIOSDevs",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DwORD\nEncoding -- 0 or NV_REG_STR_OVERRIDE_SBIOS_DEVS_NONE (Default):\nNormal windows default boot behavior\n1 or NV_REG_STR_OVERRIDE_SBIOS_DEVS_TOSHIBA_STYLE:\nThis means that the windows boot devices at boot time follow the\nToshiba policy as well as some other ideas that have been attached\nto this variable at this time.  I will clean this up into functional\npieces later rather than using it for a catch all right now. See bug 79396\n2 or NV_REG_STR_OVERRIDE_SBIOS_DEVS_TOSHIBA_OLD_STYLE:\nThis is identical to 1, or NV_REG_STR_OVERRIDE_SBIOS_DEVS_TOSHIBA_STYLE,\nwith the exception that if on LCD+TV extended when entering S4\nor rebooting, then the device selection is LCD+CRT (extended)\nwhen resuming.",
      "fields": [
        {
          "name": "OverrideSBIOSDevs",
          "bits": [0, 1],
          "states": [
            { "value": 0, "name": "NONE" },
            { "value": 1, "name": "TOSHIBA_STYLE" },
            { "value": 2, "name": "TOSHIBA_OLD_STYLE", "meaning": "Type DwORD" }
          ]
        }
      ]
    },
    {
