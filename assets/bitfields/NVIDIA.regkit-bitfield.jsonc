      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding Numeric Value in Mhz\nRegistry override for Min VCo Value in Mhz"
    },
    {
      "name": "ForceEnableHypervisor",
      "value_name": "ForceEnableHypervisor",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type: DWORD\nForce enables pass-through.\nDisabled by default",
      "fields": [
        {
          "name": "ForceEnableHypervisor",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DEFAULT" },
