    {
      "name": "Head",
      "value_name": "Head",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nThe DIV_BY value that RM should use when programming VPLL. This is primarily\nfor emulation where they generated a fixed pll clk (effectively the two\nstages of VPLL are generating a fixed clk) and just divide by the DIV_BY\nvalue to generate the pclk. Note that the pdiv that's programmed into\nthe VPLL regs is setup as 2^pdiv = DIV_BY value. So, the legal values for\nthe reg key are 2^n where n is an integer s.t. n >= 0. If a non-power of 2\nis specified via this reg key, RM will round it to next highest power of 2."
    },
    {
      "name": "HotkeyPrimaryDevScheme",
      "value_name": "HotkeyPrimaryDevScheme",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "This key is used by the RM in non-ACPI(Win9x) operation, and the display driver in ACPI (Win2K, XP).",
      "fields": [
        {
          "name": "HotkeyPrimaryDevScheme",
          "bits": [0, 1],
          "states": [
            { "value": 0, "name": "PRESERVE", "meaning": "Maintain the primary device present before the switch, if possible (default)" },
            { "value": 1, "name": "FIXED", "meaning": "Use a fixed preference order (used by Toshiba)" },
            { "value": 2, "name": "HISTORY", "meaning": "Keep a history of the user's last choice for this device combination (not implemented)" }
          ]
        }
      ]
    },
    {
      "name": "ImageEnableVblankMissLimit",
      "value_name": "ImageEnableVblankMissLimit",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD Encoding Numeric Value Number of consecutive\nheadImageEnableCallbackSequencer_NV17 callbacks that can miss actual vblanks.\nOnce this limit is reached, the screen will be immediately unblanked (SR1[5]\n= 0) instead of rescheduling the callback for the next vblank."
    },
    {
      "name": "IntrDuringShtDwn",
      "value_name": "IntrDuringShtDwn",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nWhen set to a non-zero value tells RM to not tell hw to disable supervisor\nintrs during shutdown and also handle those intrs during core channel dealloc\nif the intrs are found pending at that time."
    },
    {
      "name": "LeaveDbgModeOnAtUnfrUpd",
      "value_name": "LeaveDbgModeOnAtUnfrUpd",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nA non-zero value will make RM leave debug mode on when exiting from vbios\nrelease intr if the vbios did an unfriendly operation."
    },
    {
      "name": "LidBehavior",
      "value_name": "LidBehavior",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding -- Bit Mask\nBit 1 If set, lid closed causes us to consider LCD not present\nBit 2 If set, lid closed with LCD enabled causes spoofed hotkey (standard and clone mode)\nBit 4 If set, lid closed with LCD enabled causes spoofed hotkey (spanning mode)\nBit 5 If set, lid closed causes us to turn off displays listed in LidCloseDisplayMask"
    },
    {
      "name": "LidCloseDisplayMask",
      "value_name": "LidCloseDisplayMask",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding bit mask\nTurns off The display IDs held in the mask\nbits 0-7 Values for CRT devices\nbits 8-15 Values for TV devices\nbits 16-23 Values for DFPs, LVDS and DP devices"
    },
    {
      "name": "LocalTempHighLimit",
      "value_name": "LocalTempHighLimit",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Temperature limits\nType Dword\nEncoding Numeric Value"
    },
    {
      "name": "MapOSD3ToNV",
      "value_name": "MapOSD3ToNV",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type Dword\nEncoding Possible values 0,1,2,3,4,7\nMapping Between OS State & NV State"
    },
    {
      "name": "MapOSD4ToNV",
      "value_name": "MapOSD4ToNV",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type Dword\nEncoding Possible values 0,1,2,3,4,7\nMapping Between OS State & NV State"
    },
    {
      "name": "MaskSecondaryDevice",
      "value_name": "MaskSecondaryDevice",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type Dword\nEncoding: Bitmask of display devices.  Requires RMMaintainDevs to be enabled.\nIf a device is not connected at startup that was used during the last shutdown\nThen this registry key states which devices shouldn't be enabled as secondary by default\nIf not present, all TV devices will be removed from the secondary device by default.\nType Binary\nThis regkey will override the EDID for a particular displayID.  Just replace the\n???????? with the DWORD displayID needed to override.  This key is read at boot.\nThe binary value must be exactly 128 or 256 bytes and will be used for the EDID for\nthe displayID.  If this key is set, no DDC will be used to read the EDID for\nthe displayID.  Instead the code will skip DDC reads and use the bytes provided\nin the regkey for the EDID."
    },
    {
      "name": "MaxPerfWithPerfMon",
      "value_name": "MaxPerfWithPerfMon",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type Dword\nEncoding Numeric Value\nEnables SilentRunning performance levels using PerfMon to determine GPU utilization\nSet to 0 to disable, non-zero to enable.\nOverride thresholds for maximize performance strategy:\nBits  7:0  Percent NV   util - threshold to increase NVCLK\n15:8  Percent VP   util - threshold to increase VPCLK\n23:16  Percent FB   util - threshold to increase MCLK\n32:24  Percent PCIE util - threshold to increase PCIECLK",
      "fields": [
        {
          "name": "MaxPerfWithPerfMon",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLE" }
          ]
        }
      ]
    },
    {
      "name": "MB_CheckREV",
      "value_name": "MB_CheckREV",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding: 1 --> Make sure GPU revisions match when setting up MB (default)\n0 --> Do not check.",
      "fields": [
        {
          "name": "MB_CheckREV",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
      ]
    },
    {
      "name": "MB_DisableBr03FlowControl",
      "value_name": "MB_DisableBr03FlowControl",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding 1 -> Do not program BR03 flow control registers\n0 -> Setup BR03 flow control registers\nDetermine whether we need to program BR03 flow control registers, in objcl.c"
    },
