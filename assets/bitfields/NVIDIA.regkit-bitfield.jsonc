      "value_name": "RMUseIterativeMMUWalker",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type: Dword\nEncoding:\n0 - Iterative MMU Walker is not enabled. Normal recursive implementation is used. (default)\n1 - Iterative MMU Walker is used",
      "fields": [
        {
          "name": "RMUseIterativeMMUWalker",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLED" },
            { "value": 1, "name": "ENABLED" }
          ]
