          ]
        }
      ]
    },
    {
      "name": "RMForceNetlistNumber",
      "value_name": "RMForceNetlistNumber",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nIf set, forces a netlist number. This is needed because on emulation\nnetlists that are composed of hierarchical gates only, the register that\nexposes the netlist number to RM does not exist. However, RM has to know\nwhat the netlist number is in order to align certain code paths with\nappropriate netlist snaps. Therefore, this regkey should be used on those\nnetlists only that do not expose a netlist number."
    },
