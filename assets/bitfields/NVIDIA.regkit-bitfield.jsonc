      "comment": "Type DWORD\nEncoding boolean.\nSuppress logging of GPIO interrupts as errors. Log them as info levels instead.\n0 - Do not suppress logging as errors. This is the default.\n1 - Suppress logging as errors.",
      "fields": [
        {
          "name": "RMSuppressGPIOIntrErrLog",
          "bits": [0],
          "states": [
            { "value": 0, "name": "NO" },
            { "value": 1, "name": "YES" }
          ]
        }
      ]
    },
    {
      "name": "RmSuppressXidDump",
      "value_name": "RmSuppressXidDump",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type: Binary\nComma separated list of XID values to suppress from the kernel log\nexample:\nRmSuppressXidDump=43,31"
    },
    {
      "name": "RmSwapAcrRegions",
      "value_name": "RmSwapAcrRegions",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "TYPE Dword\nIf there is an ECC error in the write-protected ucode, this regkey will swap\nthe write-protected ACR region with another ACR region\nEncoding : 1 - Swap the ACR regions\n: 0 - Don't swap the ACR regions",
      "fields": [
        {
          "name": "RmSwapAcrRegions",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DISABLE" },
            { "value": 1, "name": "ENABLE" }
          ]
        }
      ]
    },
    {
      "name": "RMSwdxDirectCtxswSkip",
      "value_name": "RMSwdxDirectCtxswSkip",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type Dword\nWhen present and set to != 0:    RM tells ucode to skip swdx direct ctxsw\nWhen not present or set to 0:    RM tells ucode to allow swdx direct ctxsw",
      "fields": [
        {
          "name": "RMSwdxDirectCtxswSkip",
          "bits": [0],
          "states": [
            { "value": 0, "name": "DEFAULT" },
            { "value": 1, "name": "YES" }
