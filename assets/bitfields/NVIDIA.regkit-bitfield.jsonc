    {
      "name": "RMElpg",
      "value_name": "RMElpg",
      "key_paths": [
        "\\{4d36e968-e325-11ce-bfc1-08002be10318}\\"
      ],
      "bit_width": 32,
      "comment": "Type DWORD\nThis regKey is used for Engine Level Power Gating settings\nEach engine uses 1 bit. For this regkey to be used, RmPowerFeatures\ncorresponding to this feature(7:6) should have a value of 2\n0 : Enable ELPG (DEFAULT)\n1 : Disable ELPG\nRMElpg regkey should disable all MSCG, MS-LTC and MS-Passive features,\nto completely disable MS group features.\nRMElpg regkey should disable all EI and EI-Passive features,\nto completely disable EI group features.",
      "fields": [
        {
          "name": "GR",
          "bits": [0],
          "states": [
            { "value": 0, "name": "ENABLE" },
            { "value": 1, "name": "DISABLE" }
          ]
        },
        {
          "name": "PDEC",
          "bits": [1],
          "states": [
            { "value": 0, "name": "ENABLE" },
            { "value": 1, "name": "DISABLE" }
