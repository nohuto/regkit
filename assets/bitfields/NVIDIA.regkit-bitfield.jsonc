      ],
      "bit_width": 32,
      "comment": "Type DWORD\nEncoding 0 (default) - Only crash node for NVLink 1.0 sysmem link TL errors\n1           - Crash node on any NVLink TL error\n2           - Don't crash node on any NVLink TL error",
      "fields": [
        {
          "name": "RMSystemCrashOnNvLinkTlErr",
