# Restorer
msgid "A comment has an unknown registry type."
msgstr "Нераспознанный тип данных"

# Restorer
msgid "A comment type is out of range."
msgstr "Тип данных выходит за границы диапазона"

msgid "A comment contains a duplicate member."
msgstr "Обнаружено несколько повторов свойства"

msgid "A comment has an empty key."
msgstr "Отсутствуют данные в свойстве key"

msgid "A comment contains an unknown member."
msgstr "Нераспознанное свойство"

msgid "A comment is missing its text."
msgstr "Отсутствует свойство text"

# Restorer:
msgid "A key comment needs a key and can't have a name, type, size or tree."
msgstr "В комментарии раздела допустимы только свойства key и text"

msgid "The file isn't a RegKit comments file."
msgstr "Это не файл комментариев программы RegKit."

msgid "The file contains an unknown member."
msgstr "Нераспознанное свойство в файле комментариев"

msgid "Default file contains no usable entries."
msgstr "Файл предустановок содержит недопустимые записи."

msgid "Invalid hex input."
msgstr "Недопустимые шестнадцатеричные данные."

msgid "Invalid"
msgstr "Недействительно"

msgid "(Default)"
msgstr "(по умолчанию)"

msgid "An object contains an unknown member."
msgstr "Объект содержит неизвестное свойство."

msgid "An object contains a duplicate member."
msgstr "Объект содержит повторяющиеся свойство."

msgid "A state is missing its value or name."
msgstr "Отсутствует свойство value или name в поле состояния"

msgid "A field uses a bit outside the declared width."
msgstr "В битовом поле номер бита вне заданной разрядности"

msgid "Field bits must be unique and in ascending order."
msgstr ""
"В битовом поле номера битов указываются по возрастанию и не должны "
"повторяться"

msgid "A field lists no bits."
msgstr "В битовом поле не указаны номера битов"

msgid "A field lists more than 256 states."
msgstr "В битовом поле указано более 256 состояний"

msgid "A field is missing its name or bits."
msgstr "Отсутствует свойство name или bits в битовом поле"

msgid "A definition lists too many key paths."
msgstr "Превышено допустимое количество разделов реестра."

msgid "The bit width must be 8, 16, 32, or 64."
msgstr "Допустимой является разрядность 8, 16, 32 или 64 бит."

msgid "The byte offset is out of range."
msgstr "Смещение в байтах выходит за границы диапазона"

msgid "A definition contains more than 64 fields."
msgstr "Определение содержит более 64 битовых полей"

msgid "A definition is missing its value name or bit width."
msgstr "Не указано наименование параметра или разрядность"

msgid "The file isn't a RegKit bitfield definition."
msgstr "Файл не является определением битовых полей программы RegKit."

msgid "The file contains no definitions."
msgstr "Файл не содержит определений битовых полей"

msgid "The file is missing a required member."
msgstr "В файле отсутствует обязательное свойство"

msgid "Unnamed definition"
msgstr "Безымянный"

msgid "A name is longer than the format allows."
msgstr "Длина наименования превышает допустимый размер"

msgid "A comment is longer than the format allows."
msgstr "Длина текста комментария превышает допустимый размер"

msgid "A key path is empty or longer than the format allows."
msgstr ""
"Не указан раздел реестра или длина его наименования превышает допустимый "
"размер."

msgid "Every field needs a name of at most 256 characters."
msgstr ""
"Для битового поля должно быть указано наименование длиной не более 256 "
"символов."

msgid "A field meaning is longer than the format allows."
msgstr ""
"В битовом поле превышен допустимый размер текста свойства meaning."

msgid "Every field needs at least one bit."
msgstr "Битовое поле должно содержать номер бита."

msgid "Two fields claim the same bit."
msgstr "Два битовых поля содержат одинаковый номер бита."

msgid "Every state needs a name of at most 256 characters."
msgstr ""
"Для поля состояние должно быть указано наименование длиной не более 256 "
"символов."

msgid "A state meaning is longer than the format allows."
msgstr ""
"В поле состояния превышен допустимый размер текста свойства meaning."

msgid "A state value doesn't fit the bits of its field."
msgstr "Значение поля состояние выходит за пределы заданных бит в битовом поле"

msgid "Two states of one field share the same value."
msgstr "Два поля состояние одного битового поля имеют одинаковое значение"

msgid "Two fields share the same name."
msgstr "Два битовых поля содержат одинаковое наименование"

msgid "A file name or comment is longer than the format allows."
msgstr "Превышен допустимый размер наименования файла или текста комментария."

msgid "The definition file isn't valid UTF-8."
msgstr "Файл определений содержит недопустимые данные UTF-8"

msgid "The definition file isn't valid JSON."
msgstr "Файл определений содержит недопустимые данные JSON"

msgid "The definition file couldn't be read."
msgstr "Не удалось получить данные файла определений битовых полей."

msgid "The file is larger than RegKit can load."
msgstr "Превышен допустимый размер файла."

msgid "The definition file couldn't be written."
msgstr "Не удалось записать файл определений битовых полей."

