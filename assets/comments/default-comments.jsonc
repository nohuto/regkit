    },
    {
      "name": "SchedulerPeriod",
      "type": "REG_DWORD",
      "size": 4,
      "key": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile",
      "text": "https://noverse.dev/docs/win-config/system/mmcss-values/#schedulerperiod"
    },
