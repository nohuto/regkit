IDD_EXPORT_OPTIONS DIALOGEX 0, 0, 280, 114
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Export"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Export to:",IDC_STATIC,8,6,50,8
    EDITTEXT        IDC_EXPORT_PATH,8,18,204,11,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_EXPORT_BROWSE,218,18,55,11
    GROUPBOX        "Export range",IDC_STATIC,8,38,264,40
    AUTORADIOBUTTON "Selected key and subkeys",IDC_EXPORT_RANGE_BRANCH,16,50,150,10,WS_GROUP
    AUTORADIOBUTTON "Selected key only",IDC_EXPORT_RANGE_KEY,16,62,120,10
    AUTOCHECKBOX    "Open file after export",IDC_EXPORT_OPEN_AFTER,8,86,160,10
    DEFPUSHBUTTON   "OK",IDOK,178,96,45,11
    PUSHBUTTON      "Cancel",IDCANCEL,227,96,45,11
END

