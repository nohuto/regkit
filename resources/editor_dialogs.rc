    EDITTEXT        IDC_REG_BINARY_EDIT,16,58,388,28,ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT           "Preview:",IDC_REG_BINARY_LABEL_PREVIEW,16,90,60,8
    EDITTEXT        IDC_REG_BINARY_PREVIEW,16,102,388,40,ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | ES_READONLY
