    AUTORADIOBUTTON "DWord",IDC_REG_NONE_FORMAT_DWORD,128,156,52,10
    AUTORADIOBUTTON "QWord",IDC_REG_NONE_FORMAT_QWORD,186,156,52,10
    GROUPBOX        "Text",IDC_REG_NONE_TEXT_GROUP,272,146,132,26
    AUTORADIOBUTTON "ANSI",IDC_REG_NONE_TEXT_ANSI,280,156,44,10,WS_GROUP
    AUTORADIOBUTTON "Unicode",IDC_REG_NONE_TEXT_UNICODE,326,156,60,10
