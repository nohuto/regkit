IDD_INPUT DIALOGEX 0, 0, 220, 75
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Input"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Name:",IDC_VALUE_NAME_LABEL,8,4,30,8
    EDITTEXT        IDC_VALUE_NAME,8,14,204,11,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Type:",IDC_VALUE_TYPE_LABEL,8,14,30,8
    LTEXT           "",IDC_VALUE_TYPE,42,14,168,8
    LTEXT           "Value data:",IDC_LABEL,8,31,80,8
    EDITTEXT        IDC_EDIT,8,41,204,11,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,117,58,45,11
    PUSHBUTTON      "Cancel",IDCANCEL,167,58,45,11
END


