IDD_CUSTOM_VALUE DIALOGEX 0, 0, 420, 209
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Edit Value"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Name:",IDC_VALUE_NAME_LABEL,8,4,30,8
    EDITTEXT        IDC_VALUE_NAME,42,4,370,11,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Type:",IDC_VALUE_TYPE_LABEL,8,18,30,8
    COMBOBOX        IDC_TYPE_COMBO,42,16,200,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "REG_SZ",IDC_GROUP_REG_SZ,8,34,404,152
    EDITTEXT        IDC_REG_SZ_EDIT,16,50,388,11,ES_AUTOHSCROLL
    GROUPBOX        "REG_EXPAND_SZ",IDC_GROUP_REG_EXPAND,8,34,404,152
    EDITTEXT        IDC_REG_EXPAND_EDIT,16,50,388,11,ES_AUTOHSCROLL
