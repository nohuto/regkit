    AUTORADIOBUTTON "Byte",IDC_REG_BINARY_FORMAT_BYTE,24,156,44,10,WS_GROUP
    AUTORADIOBUTTON "Word",IDC_REG_BINARY_FORMAT_WORD,76,156,44,10
    AUTORADIOBUTTON "DWord",IDC_REG_BINARY_FORMAT_DWORD,128,156,52,10
    AUTORADIOBUTTON "QWord",IDC_REG_BINARY_FORMAT_QWORD,186,156,52,10
    GROUPBOX        "Text",IDC_REG_BINARY_TEXT_GROUP,272,146,132,26
    AUTORADIOBUTTON "ANSI",IDC_REG_BINARY_TEXT_ANSI,280,156,44,10,WS_GROUP
    AUTORADIOBUTTON "Unicode",IDC_REG_BINARY_TEXT_UNICODE,326,156,60,10
    GROUPBOX        "REG_NONE",IDC_GROUP_REG_NONE,8,34,404,152
    LTEXT           "Hex bytes:",IDC_REG_NONE_LABEL_HEX,16,46,60,8
    EDITTEXT        IDC_REG_NONE_EDIT,16,58,388,28,ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
