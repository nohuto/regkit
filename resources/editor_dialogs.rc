IDD_BINARY DIALOGEX 0, 0, 380, 206
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Binary"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Name:",IDC_VALUE_NAME_LABEL,8,4,30,8
    EDITTEXT        IDC_VALUE_NAME,8,14,364,11,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Bytes:",IDC_VALUE_BYTES_LABEL,276,4,30,8
    LTEXT           "0 bytes",IDC_VALUE_BYTES,308,4,64,8
    LTEXT           "Type:",IDC_VALUE_TYPE_LABEL,8,14,30,8
    LTEXT           "",IDC_VALUE_TYPE,42,14,330,8
    LTEXT           "Hex bytes:",IDC_LABEL,8,31,364,8
    EDITTEXT        IDC_EDIT,8,41,364,32,ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT           "Preview:",IDC_NOTE,8,79,364,8
    EDITTEXT        IDC_BINARY_PREVIEW,8,89,364,60,ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | ES_READONLY
    GROUPBOX        "Format",IDC_FORMAT_GROUP,8,155,248,28
    AUTORADIOBUTTON "Byte",IDC_FORMAT_BYTE,16,164,48,10,WS_GROUP
    AUTORADIOBUTTON "Word",IDC_FORMAT_WORD,72,164,48,10
    AUTORADIOBUTTON "DWord",IDC_FORMAT_DWORD,128,164,52,10
    AUTORADIOBUTTON "QWord",IDC_FORMAT_QWORD,188,164,52,10
    GROUPBOX        "Text",IDC_TEXT_GROUP,264,155,108,28
    AUTORADIOBUTTON "ANSI",IDC_TEXT_ANSI,272,164,40,10,WS_GROUP
    AUTORADIOBUTTON "Unicode",IDC_TEXT_UNICODE,314,164,56,10
    DEFPUSHBUTTON   "OK",IDOK,274,189,45,11
    PUSHBUTTON      "Cancel",IDCANCEL,324,189,45,11
END


