    AUTOCHECKBOX    "Recursive",IDC_COMPARE_RIGHT_RECURSIVE,478,107,70,10

    GROUPBOX        "Results",IDC_STATIC,8,128,280,24
    AUTORADIOBUTTON "Both",IDC_COMPARE_SHOW_BOTH,16,137,36,10,WS_GROUP
    AUTORADIOBUTTON "Only differences",IDC_COMPARE_SHOW_DIFFERENCES,56,137,88,10
    AUTORADIOBUTTON "Only matching",IDC_COMPARE_SHOW_MATCHING,148,137,88,10

    DEFPUSHBUTTON   "Compare",IDOK,462,141,45,11
